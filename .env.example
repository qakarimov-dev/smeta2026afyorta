# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=7123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Bot Adminlari Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# Kunlik hisobot yuboriladigan Telegram ID
REPORT_RECIPIENT_ID=123456789

# Kunlik hisobot yuborish vaqti (Format: SS:DD)
DAILY_REPORT_TIME=21:00

# AI provayderini tanlang: 'gemini' yoki 'openai' (default: openai)
AI_PROVIDER=openai

# Google Gemini API kaliti (https://aistudio.google.com/ orqali bepul olinadi)
GEMINI_API_KEY=AIzaSy...

# OpenAI API kaliti (https://platform.openai.com/ orqali olinadi)
OPENAI_API_KEY=sk-proj-...

# Model nomi (gpt-4o-mini yoki gemini-2.5-flash)
AI_MODEL=gpt-4o-mini

# Har bir foydalanuvchi bilan saqlanadigan xabarlar tarixi soni (kontekst uchun)
MAX_HISTORY_MESSAGES=10
